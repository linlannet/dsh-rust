{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dsh.v1.config.harness",
  "title": "HarnessConfig",
  "description": "harness.yml 的契约草案。api-keys 等敏感字段不得写入 fixture。",
  "type": "object",
  "properties": {
    "server": {
      "type": "object",
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      },
      "additionalProperties": true
    },
    "harness": {
      "type": "object",
      "properties": {
        "auth": {
          "type": "object",
          "properties": {
            "api-keys": {
              "type": "array",
              "items": { "type": "string" },
              "x-sensitive": true
            }
          },
          "additionalProperties": true
        },
        "agent": {
          "type": "object",
          "properties": {
            "tool-timeout-ms": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        },
        "approval": {
          "type": "object",
          "properties": {
            "required-tools": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        },
        "llm": { "type": "object", "additionalProperties": true },
        "extensions": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "workspace": {
      "type": "object",
      "properties": {
        "root": { "type": "string" }
      },
      "additionalProperties": true
    },
    "plugins": {
      "type": "object",
      "properties": {
        "install-root": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
